<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- para a atualização automática continuar depois de reiniciar o celular -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- avisos do Helpdesk -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- modo tempo real: alarme exato para acordar o celular com a tela desligada -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- atualizar o próprio app pelas versões publicadas no GitHub (o Android pede confirmação) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- downloads do site em celulares antigos (Android 9 ou menor) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- apps de câmera (botão "Tirar foto" dos anexos) -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application>
        <activity
            android:name="br.com.cbfreedom.comum.Tela"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/TemaFreedom"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- envia o que ficou guardado sem internet assim que a conexão voltar -->
        <service
            android:name="br.com.cbfreedom.comum.FilaTarefa"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- imagens PNG dos painéis para o "Compartilhar" (WhatsApp, e-mail…) -->
        <provider
            android:name="br.com.cbfreedom.comum.Imagens"
            android:authorities="${applicationId}.imagens"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name="br.com.cbfreedom.comum.Tarefa"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- modo tempo real do Helpdesk (aviso fixo na barra) -->
        <service
            android:name="br.com.cbfreedom.comum.HelpdeskServico"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Monitorar os chamados do Helpdesk da empresa e avisar quando mudam" />
        </service>

        <!-- widget do Helpdesk (números da Central de Atendimento e chamados em aberto) -->
        <receiver
            android:name="br.com.cbfreedom.comum.WidgetHelpdesk"
            android:exported="false"
            android:label="@string/widget_helpdesk">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_helpdesk" />
        </receiver>

        <receiver
            android:name="br.com.cbfreedom.comum.HelpdeskAlarme"
            android:exported="false" />

        <!-- botões Responder / Assumir dos avisos de chamado -->
        <receiver
            android:name="br.com.cbfreedom.comum.ChamadoAcao"
            android:exported="false" />

        <!-- resposta do instalador do Android na atualização do app -->
        <receiver
            android:name="br.com.cbfreedom.comum.AtualizacaoRecebedor"
            android:exported="false" />

        <receiver
            android:name="br.com.cbfreedom.comum.Inicio"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
