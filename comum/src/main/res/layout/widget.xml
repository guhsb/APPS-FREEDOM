<?xml version="1.0" encoding="utf-8"?>
<!-- O widget é uma imagem desenhada pelo app (não muda com o tamanho da letra do celular).
     Tocar no canto de cima à direita (horário) atualiza; tocar no resto abre a tela cheia. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Painel Freedom" />

    <FrameLayout
        android:id="@+id/zona_atualizar"
        android:layout_width="96dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end" />
</FrameLayout>
